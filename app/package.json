{
  "name": "automabuild-app",
  "version": "0.1.0",
  "private": true,
  "description": "The four components composed into one running system.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=../.env src/migrate.ts",
    "start": "node --env-file-if-exists=../.env src/server.ts",
    "demo": "node --env-file-if-exists=../.env src/demo.ts",
    "test": "node --test \"test/*.test.ts\"",
    "send": "node --env-file-if-exists=../.env scripts/send-webhook.mjs",
    "smtp:check": "node --env-file-if-exists=../.env scripts/smtp-check.mjs"
  },
  "dependencies": {
    "automa-durable-runner": "*",
    "automa-safe-fetch": "^0.1.1",
    "automa-webhook-gate": "*",
    "fastify": "^5.12.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
