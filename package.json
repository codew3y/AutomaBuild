{
  "name": "automa-safe-fetch",
  "version": "0.1.0",
  "description": "An HTTP client for applications that fetch user-supplied URLs, without letting those users reach the inside of your network. SSRF defence: resolve, validate, pin.",
  "keywords": ["ssrf", "fetch", "security", "dns-rebinding", "webhook", "http-client"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/codew3y/automa-safe-fetch.git" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20.6.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "test:online": "SAFE_FETCH_ONLINE=1 node --test \"test/online.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
