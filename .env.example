# Copy to .env and fill in. .env is gitignored — keep it that way.
#
# Read by npm start, demo, db:migrate, send and smtp:check, through Node's own
# --env-file-if-exists. Deliberately not read by `npm test`: a suite that picks
# up whatever is in a local .env passes or fails for reasons that are not in
# the repository, and CI would then disagree with a laptop for invisible
# reasons.
#
# A real environment variable wins over anything set here, so a one-off run can
# still override a single value without editing the file.

# The signing secret the gate checks deliveries against. A comma-separated
# list while a secret is being rotated; every one in it is accepted.
#
# Blank on purpose. A working value here would be a secret published in a
# public repository — and worse, one that looks like a default, so it would
# end up in more than one person's .env and stay there until something was
# exposed. Generate your own and keep it out of git:
#
#     node -e "console.log('whsec_' + require('crypto').randomBytes(24).toString('base64url'))"
#
# It has to match whatever is signing the deliveries.
WEBHOOK_SECRETS=

# Which signing convention deliveries use: stripe, github, slack or standard.
# Defaults to stripe, which is what scripts/send-webhook.mjs produces.
# WEBHOOK_SCHEME=stripe

# ---------------------------------------------------------------- email ----
# For Gmail this is an App Password, not the account password: sixteen
# characters, no spaces. Two-step verification has to be on for one to exist.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
SMTP_FROM=AutomaBuild <you@example.com>

# Refuse to send anywhere else. Left empty, an email step can send to any
# address a webhook body asks it to — which is the point in a workflow tool,
# and a way to become an open relay if the endpoint is ever exposed. Set it to
# a comma-separated list of addresses or @domains while testing.
# SMTP_ALLOWED_RECIPIENTS=@example.test

# ------------------------------------------------------------- optional ----
# PORT=8080
# HOST=127.0.0.1
# API_KEY=                     # required by the editor's API if set
# CANVAS_DIR=../packages/automa-flow-canvas/dist
