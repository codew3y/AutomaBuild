{
  "name": "automa-webhook-gate",
  "version": "0.0.0",
  "description": "Verify inbound webhooks properly: raw body, constant-time comparison, timestamp window, replay protection.",
  "license": "MIT",
  "author": "Wey Tongol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codew3y/automa-webhook-gate.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && node scripts/check-control-chars.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage \"test/*.test.ts\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "node scripts/migrate.ts",
    "demo": "node src/demo.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "fastify": "^5.12.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "keywords": [
    "webhook",
    "hmac",
    "signature-verification",
    "replay-protection",
    "stripe",
    "github",
    "slack",
    "standard-webhooks",
    "fastify"
  ],
  "homepage": "https://github.com/codew3y/automa-webhook-gate#readme",
  "bugs": {
    "url": "https://github.com/codew3y/automa-webhook-gate/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
